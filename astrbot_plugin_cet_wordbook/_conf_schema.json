{
  "wordbook": {
    "type": "string",
    "description": "词书",
    "hint": "选择四级或六级词书",
    "default": "四级",
    "options": [
      "四级",
      "六级"
    ]
  },
  "words_per_day": {
    "type": "int",
    "description": "每天发送单词数",
    "hint": "每天一共发多少个单词，会自动分配到各个时段",
    "default": 20
  },
  "send_mode": {
    "type": "string",
    "description": "发送间隔方式",
    "hint": "按小时=每个整点；每N小时=每隔N小时；每N分钟=每隔N分钟",
    "default": "每小时",
    "options": [
      "每小时",
      "每N小时",
      "每N分钟"
    ]
  },
  "interval_value": {
    "type": "int",
    "description": "间隔数值",
    "hint": "选「每N小时」或「每N分钟」时生效",
    "default": 1
  },
  "rest_start": {
    "type": "int",
    "description": "休息开始时间",
    "hint": "几点开始不发（24小时制，默认8点）",
    "default": 8
  },
  "rest_end": {
    "type": "int",
    "description": "休息结束时间",
    "hint": "几点恢复发送（24小时制，默认22点）",
    "default": 22
  },
  "quizzes_per_day": {
    "type": "int",
    "description": "每天小测题数",
    "hint": "每天自动出多少道选择题，0 表示关闭",
    "default": 3
  },
  "quiz_batch": {
    "type": "int",
    "description": "每次小测题数",
    "hint": "每条小测消息包含几道题，建议 1-3",
    "default": 1
  },
  "wrongbook_days": {
    "type": "int",
    "description": "错题本推送间隔（天）",
    "hint": "每多少天把错题本发一次，0 表示不自动推送",
    "default": 7
  },
  "target_session": {
    "type": "string",
    "description": "推送会话",
    "hint": "留空则自动使用最近一次私聊会话",
    "default": ""
  },
  "quiz_source": {
    "type": "string",
    "description": "出题范围",
    "hint": "今日单词=只考今天推送过的词；整本词书=从整本书随机",
    "default": "整本词书",
    "options": [
      "今日单词",
      "整本词书"
    ]
  },
  "quiz_time": {
    "type": "int",
    "description": "小测时间",
    "hint": "0=均匀分布在全天；1-23=固定在几点出（比如 21）",
    "default": 0
  }
}